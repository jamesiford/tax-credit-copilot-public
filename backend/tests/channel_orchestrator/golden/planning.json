      {"say": "And what is their trend?",
       "model": [{"tools": [{"tool": "client_trend", "args": {}}]}, {"text": "The table shows each year."}],
       "expect": {"kind": "answer", "gateway": ["client_resolve", "client_trend"], "args": {"client_trend": {"client_id": 2002}}, "absent": ["Which client do you mean?"]}}
    ]
  },
  {
    "name": "planning_a_book_question_after_a_client_is_still_the_whole_book",
    "turns": [
      {"say": "Give me a brief on Northwind Care Systems",
       "model": [{"tools": [{"tool": "client_situation", "args": {}}]}, {"text": "Here is where they stand."}],
       "expect": {"kind": "answer", "gateway": ["client_resolve", "client_situation"]}},
      {"say": "Now, across all our clients, who is worth contacting this week?",
       "model": [{"tools": [{"tool": "book_rank", "args": {}}]}, {"text": "The table ranks every client."}],
       "expect": {"kind": "answer", "gateway": ["book_rank"]}}
    ]
  },
  {
    "name": "planning_a_what_if_resolves_the_client_then_simulates",
    "turns": [{
      "say": "What if Cascade Retail Partners hired 3 more people at site A-1 in 2023?",
