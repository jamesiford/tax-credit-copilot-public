[
  {
    "name": "planning_whole_book_runs_book_rank_and_resolves_no_client",
    "turns": [{
      "say": "Which of our clients should we call first and why?",
      "model": [{"tools": [{"tool": "book_rank", "args": {}}]}, {"text": "Start with {{facts.book_rank.rows.0.name}}, which the page puts under {{facts.book_rank.rows.0.band}}."}],
      "expect": {"kind": "answer", "mode": "tools", "gateway": ["book_rank"], "guard": "pass", "narration_used": true, "audit": "ok",
                 "contains": ["Start with Cascade Retail Partners", "Who to call"], "absent": ["position", "Which client do you mean?"]}
    }]
  },
  {
    "name": "planning_named_client_brief_resolves_the_client_then_uses_the_client_tool",
    "turns": [{
