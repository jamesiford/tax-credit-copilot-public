      "expect": {"kind": "answer", "gateway": ["client_resolve", "simulate"], "args": {"simulate": {"client_id": 2001, "tax_year": 2023, "worksite_id": "A-1", "magnitude": 3}}, "guard": "pass"}
    }]
  },
  {
    "name": "planning_an_at_risk_question_resolves_the_client_then_reads_at_risk",
    "turns": [{
      "say": "Which counted jobs at Ironbridge Logistics could fall out of the credit in 2023?",
