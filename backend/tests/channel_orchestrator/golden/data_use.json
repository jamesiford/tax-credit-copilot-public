[
  {
    "name": "use_descriptive_by_location",
    "turns": [{
      "say": "For Northwind, what is the average headcount at each location?",
      "model": [{"tools": [{"tool": "data_catalog", "args": {"dataset": "unit_month_summary"}},
                           {"tool": "data_query", "args": {"dataset": "unit_month_summary", "select": ["worksite_id"], "measures": [{"column": "average_headcount", "agg": "avg", "as": "avg_headcount"}]}}]},
                {"text": "{{facts.data_query.rows.0.worksite_id}} leads the table with an average headcount of {{facts.data_query.rows.0.avg_headcount|headcount}}."}],
      "expect": {"kind": "answer", "mode": "tools", "gateway": ["data_catalog", "client_resolve", "data_query"], "guard": "pass", "narration_used": true,
                 "args": {"data_query": {"client_id": 2002, "dataset": "unit_month_summary"}},
                 "contains": ["worksite_id-2002-0 leads the table with an average headcount of 3.5", "Source: warehouse tcc_gold.unit_month_summary"],
                 "absent": ["Queryable data"]}
    }]
  },
  {
