# Local development environment. Copy to `.env` and edit.
#
# Rule for this file: every value that looks like a real address or name is COMMENTED OUT, so leaving a
# line as it is can never make the app try to connect somewhere. Uncomment and fill in only what you use.
# An OS environment variable overrides `.env`; the startup log says which one won for telemetry.
#
# Reference for every setting: docs/architecture/ENV-VARS.md

# =============================================================================
# 1. Where the process runs, and who may sign in
# =============================================================================
#
# ENVIRONMENT        `local` (default) for a clone, tests and CI; anything else means deployed. A deployed
#                    process refuses to start unless every store below is `warehouse`.
# DATA_CLASSIFICATION `synthetic` or `customer`. Required when deployed; never inferred.
# AUTH_MODE          `entra` (default) or `none`. `none` is a local opt-in and needs ENVIRONMENT=local too.
ENVIRONMENT=local
AUTH_MODE=none
#   DATA_CLASSIFICATION=synthetic
#   AUTH_TENANT_ID=<entra tenant id>               # falls back to AZURE_TENANT_ID
#   API_AUDIENCE=api://<api app registration client id>

# =============================================================================
# 2. Payroll source: the Fabric lakehouse over OneLake
# =============================================================================
#
# DATA_SOURCE   `lakehouse` (default; a blank value means the same). `csv` is a test fixture, never a data
#               source, and is used only when set explicitly. `fabric` is an early flattened demo slice.
#               With `lakehouse` and no FABRIC_WORKSPACE / FABRIC_LAKEHOUSE the API answers 503 naming them.
DATA_SOURCE=lakehouse
#   FABRIC_WORKSPACE=<workspace-name-or-id>
#   FABRIC_LAKEHOUSE=<lakehouse-name-or-id>
#
# Lakehouse schema holding the source tables. Unset: `tcc_source`. Set but EMPTY (`SOURCE_SCHEMA=`): a
# lakehouse that is NOT schema-enabled (`Tables/<table>`), and the app logs a startup warning saying so. Easy to
# do by accident from a copied template: remove the line, or set the schema (`SOURCE_SCHEMA=dbo`) if the
# lakehouse is schema-enabled. `python scripts/check-onelake-access.py --probe-layout` tells you which layout
# opens the table.
#   SOURCE_SCHEMA=tcc_source
#
# Physical table names, when they differ from the logical ones (Payroll, Account, ...). The prefix is
# prepended, SOURCE_TABLE_CASE (`as_is`, `lower`, `upper`) is applied to the whole name, and the JSON map
# (logical -> physical) wins over both. Interim: a later release replaces these with a full data-model mapping.
#   SOURCE_TABLE_PREFIX=<prefix_>
#   SOURCE_TABLE_CASE=lower
#   SOURCE_TABLE_MAP={"Payroll": "<physical_name>"}
#
# A workspace that blocks public access: the workspace-specific private-link BLOB host, and the path style
# (`name` addresses names, `guid` addresses the workspace id and the lakehouse item id). Check it with
# `python scripts/check-onelake-access.py`.
#   ONELAKE_ENDPOINT=https://<workspaceid-no-dashes>.z<xy>.blob.fabric.microsoft.com
#   ONELAKE_PATH_STYLE=name
#
# `delta` lets a failing SQL read of a client's fiscal rules fall back to a bounded lakehouse read, logged.
# Unset: no fallback. Never applies to claims, engagements, findings or manifests.
#   SOURCE_FALLBACK=delta
#
# The portfolio page's footprint (which states each client has payroll in) is one scan of the whole payroll
# table. `auto` estimates the row count without scanning and refuses above the limit; `on` always runs it under
# the timeout (the driver cancels the statement on the server); `off` never runs it.
#   PORTFOLIO_FOOTPRINT_MODE=auto
#   PORTFOLIO_FOOTPRINT_MAX_ROWS=50000000
#   PORTFOLIO_FOOTPRINT_TIMEOUT_SECONDS=20
#
# Warm the lakehouse read paths in a background thread at startup. Ignored unless DATA_SOURCE=lakehouse.
#   TCC_WARM_ON_START=1

# =============================================================================
# 3. Identity (one shared Azure credential for everything that talks to Azure)
# =============================================================================
#
# Locally the managed-identity probe is skipped (it only adds a long wait): sign in with `az login`.
# AZURE_TOKEN_CREDENTIALS chooses the credential yourself: `dev`, `prod`, or one name such as
# `azureclicredential`. Deployed, AZURE_CLIENT_ID selects the app's user-assigned identity.
#   AZURE_TOKEN_CREDENTIALS=dev
#   AZURE_CLIENT_ID=<user-assigned identity client id>

# =============================================================================
# 4. Telemetry
# =============================================================================
#
# On only when a connection string is set. An empty value disables it. TELEMETRY_ENABLED=false disables it
# even when the string is set. If the exporter is refused (403) the app logs one warning with the likely
# causes (Entra authentication not enabled on the resource, no Monitoring Metrics Publisher role, wrong
# identity) and carries on.
#   APPLICATIONINSIGHTS_CONNECTION_STRING=<connection string>
#   TELEMETRY_ENABLED=true

# =============================================================================
# 5. Operational store: claims, engagements, findings, run manifests
# =============================================================================
#
#   sqlite     local dev and CI. Writes a file; needs no cloud account.
#   memory     in-process; gone when the process exits.
#   warehouse  every deployed environment: `tcc_ops` in the Warehouse (section 6). `fabric` is the v1 alias.
#
# Keep these consistent with section 6: SQLite stores while a warehouse is configured is warned about at
# startup. Verify a warehouse store with `python scripts/check-operational-store.py`.
CLAIM_STORE=sqlite
FINDING_STORE=sqlite
RUN_MANIFEST_STORE=memory
#   OPERATIONAL_DB=data/operational.db             # sqlite adapters only

# Artifacts. `local` (default) or `blob`; the repository is `sqlite` (default) or `warehouse`.
#   ARTIFACT_STORE=local
#   ARTIFACT_REPOSITORY=sqlite
#   ARTIFACT_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
#   OUTPUTS_RETENTION_DAYS=2555

# =============================================================================
# 6. Analytical store: the Fabric Warehouse (`tcc_gold`, `tcc_ops`)
# =============================================================================
#
# Needed once the portal is served from Gold or a store above is `warehouse`. Requires "ODBC Driver 18 for
# SQL Server" on the host. Access is a Fabric workspace role plus T-SQL grants, not Azure RBAC.
#   WAREHOUSE_SERVER=<id>.datawarehouse.fabric.microsoft.com
#   WAREHOUSE_DATABASE=<warehouse-database-name>
#   WAREHOUSE_ODBC_DRIVER=ODBC Driver 18 for SQL Server
#   WAREHOUSE_CONNECT_TIMEOUT=90

# =============================================================================
# 7. AI: Foundry and the model gateway
# =============================================================================
#
# Only needed once agents make real model calls; the scripted answers work without them.
#   FOUNDRY_PROJECT_ENDPOINT=https://<aiservices-account>.services.ai.azure.com/api/projects/<project>
#   FOUNDRY_MODEL=<chat model deployment name>

# =============================================================================
# 8. Rules ingestion (optional)
# =============================================================================
#
# The RulesIngestionAgent retrieves and cites rules from primary sources. Leave unset to run offline
# (a captured cited snapshot; live retrieval reports NEEDS_KEY). NEVER commit a real key.
#   WEBIQ_API_KEY=
#   WEBIQ_BASE_URL=https://api.microsoft.ai/v3
#   WEBIQ_BEARER_TOKEN=

# =============================================================================
# 9. Build stamp
# =============================================================================
#
# Recorded in the calculation trail so a figure can be tied back to the code that produced it. Unset
# locally means "unknown", which is honest.
#   GIT_COMMIT=
