# Local dev environment. Copy to `.env` and fill in.
# These are only needed once Phase 2 wires real agent calls — Phase 1 stubs
# work without them.

# Foundry project endpoint. Format:
#   https://<aiservices-account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Name of the chat model deployment in the Foundry project.
FOUNDRY_MODEL=gpt-5.4-mini

# Optional: App Insights for OpenTelemetry. Leave empty to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Web IQ — used by the RulesIngestionAgent to retrieve + cite GA JTC
# rules from primary sources (tools/webiq.py). Get a key from
# https://webiq.microsoft.ai/profiles and paste it here. NEVER commit a real key.
# Leave empty to run offline (captured cited snapshot; live retrieval reports NEEDS_KEY).
WEBIQ_API_KEY=
# Optional overrides:
#   WEBIQ_BASE_URL=https://api.microsoft.ai/v3
#   WEBIQ_BEARER_TOKEN=   # Entra client-credentials token (scope https://api.microsoft.ai/.default), instead of the key

# --- [ROADMAP-V · Phase F] Microsoft Fabric data source (OneLake) -------------
# Three sources, and the difference between the two Fabric ones matters.
#
#   csv        Local file, one tenant. Deterministic and offline — the default so a
#              clone runs with no cloud access at all.
#
#   lakehouse  The customer's SOURCE schema from the Lakehouse (`SOURCE_SCHEMA`
#              below, default `tcc_source`; data/source/from_fabric.FabricLakehouseReader).
#              **Multi-tenant**: five accounts, 564,931 rows, TY2020–TY2026,
#              including the reference dataset client (Candle Bottle, 1001) at
#              384,433 rows / 10,236 employees. This is the shape the customer
#              actually hands us, the projection is proven lossless by
#              tests/test_source_roundtrip.py, and it reproduces the certified
#              10,236 / 539 / 656 end to end.
#              ** This is the one you want. **
#              `flex` is accepted as a DEPRECATED ALIAS for `lakehouse` — it
#              resolves identically and logs a DeprecationWarning.
#
#   fabric     The flattened demo `employees` table under the `dbo` schema
#              (tools/fabric_source.FabricOneLakeAdapter). **Single tenant, 9,477
#              rows, 305 employees, no account column** — an early flattened slice
#              that predates the lakehouse model. It cannot serve portfolio scope,
#              the retroactive years, or the reference client. Kept because the
#              ingestion tests still exercise the flattened mapping.
#
# Pointing at `fabric` when you meant `lakehouse` fails quietly: the app starts,
# one client resolves, and every portfolio view is simply thin. Nothing errors.
#
# Auth is an Entra token for https://storage.azure.com/.default via
# DefaultAzureCredential (az login, service principal, or managed identity).
# Requires `deltalake[pyarrow]` — no ODBC driver.
#
# OneLake access needs the Fabric workspace role plus two tenant settings:
# "service principals can use Fabric APIs" and "apps external to Fabric can
# access OneLake". See docs/roadmaps/ROADMAP-V.md.
#
# A PAUSED capacity answers reads with `ArtifactNotFound`, which is
# indistinguishable from a missing lakehouse. Check the capacity state first:
#   az resource show -g rg-valc-demo-eastus -n fabvalcdemowestus3 \
#     --resource-type Microsoft.Fabric/capacities --query properties.state
#
# An ACTIVE capacity can still fail every read with "client error (Connect) ->
# operation timed out ... after 10 retries". That is not the network: opening the
# tiny `Account` Delta log has been measured at 13-38s while an unauthenticated
# GET of the same URL answers 401 in 0.7s. OneLake on this F2 capacity accepts
# connections slowly, and object_store's 5s default connect timeout abandons
# them. `_TRANSPORT_OPTIONS` in data/source/from_fabric.py waits them out instead.
# Reads still take tens of seconds when the capacity is degraded; the lever for
# that is the SKU, not the code.
# `lakehouse` is the default and the only shape the product ships against.
# `fabric` is an early flattened slice kept because the ingestion tests exercise it.
#
# `csv` is NOT a data source. `backend/data/payroll_pay_periods.csv` is a test
# fixture that `tests/conftest.py` selects so the suite stays offline and
# deterministic — CI has no Fabric credential. It is not deployable: a
# misconfigured environment must fail rather than answer from a synthetic
# single-tenant file that looks like a client result.
DATA_SOURCE=lakehouse
#   FABRIC_WORKSPACE=<workspace-name-or-guid>
#   FABRIC_LAKEHOUSE=<lakehouse-name>
#   FABRIC_EMPLOYEES_TABLE=dbo/employees                # `fabric` source only
#   SOURCE_SCHEMA=tcc_source                            # the lakehouse schema holding
#                                                        # the source payroll (D14);
#                                                        # a customer overlay may set
#                                                        # this to its own schema name

# Which account the reference client (Candle Bottle) is read under on `lakehouse`.
#   FLEX_ACCOUNT_ID=1001

# Warm the lakehouse read paths in a background thread at startup, so the first
# screen does not pay the cold-read cost. Ignored unless DATA_SOURCE=lakehouse.
# Set to 0 to start clean when measuring a cold request.
#   TCC_WARM_ON_START=1

# --- Deployment posture [D26, DATA-5] ----------------------------------------
#
# ENVIRONMENT  `local` (default) for a clone, tests and CI; anything else means
#              deployed. A deployed process refuses to start unless EVERY store
#              below is `warehouse` — SQLite and memory lose decisions that land
#              on a filed return.
# DATA_CLASSIFICATION  `synthetic` or `customer`. Required when deployed; never
#              inferred.
#   ENVIRONMENT=local
#   DATA_CLASSIFICATION=synthetic
#
# AUTH_MODE    `none` (default; local and synthetic demos) or `entra`. Under
#              `entra` every route except /api/health and /api/ready needs a v2
#              bearer token for API_AUDIENCE with scope `user_impersonation` and
#              app role `TCC.User` (401 without proof, 403 without permission).
#              `none` with DATA_CLASSIFICATION=customer refuses to start when
#              ENVIRONMENT is not local (D26).
#   AUTH_MODE=none
#   AUTH_TENANT_ID=<entra tenant id>          # falls back to AZURE_TENANT_ID
#   API_AUDIENCE=api://<api app registration client id>

# --- Artifacts [BLOB-3, BLOB-6] ----------------------------------------------
#
# ARTIFACT_STORE       `local` (default: backend/data/artifacts, dev/CI) or `blob`.
# ARTIFACT_REPOSITORY  `sqlite` (default) or `warehouse` (tcc_ops.artifact and
#                      artifact_access). Deployed environments must use blob +
#                      warehouse. Downloads stream through the API; no SAS ever
#                      reaches a browser.
#   ARTIFACT_STORE=local
#   ARTIFACT_REPOSITORY=sqlite
#   ARTIFACT_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
#   OUTPUTS_RETENTION_DAYS=2555
# --- Operational store [ADR-007] ---------------------------------------------
#
# Independent selectors, because each holds decisions that land on a filed
# return and each must outlive the process that wrote them.
#
#   sqlite     local dev and CI. Writes a file; needs no cloud account.
#   memory     an in-process SQLite database; gone when the process exits.
#   warehouse  every deployed environment: tcc_ops in the Fabric Warehouse
#              (WAREHOUSE_SERVER / WAREHOUSE_DATABASE below). `fabric` is
#              accepted as the v1 alias.
CLAIM_STORE=sqlite
FINDING_STORE=sqlite
#   OPERATIONAL_DB=data/operational.db                   # sqlite adapters only

# --- Analytical store: the Fabric Warehouse [ADR-007] ------------------------
#
# Calculation output is analytical, high-volume and read-mostly, so it belongs
# in the medallion. `tcc_gold` holds the figures every
# screen will read; `tcc_ops` holds run provenance. Both schemas are already
# deployed — see docs/data/schema/tcc-schema.fabric.sql. Do not create tables.
#
#   memory     the default. CI and a fresh clone: no ODBC driver, no credential,
#              no capacity. Durable for exactly one process, and it says so
#              (`is_durable = False`).
#   warehouse  every deployed environment (`fabric` is the v1 alias). Requires
#              "ODBC Driver 18 for SQL Server" on the host — the wheel alone is
#              not enough.
#
# Auth is an Entra token for https://database.windows.net/.default, passed as
# ODBC attribute 1256 rather than in the connection string. That is a DIFFERENT
# audience from the OneLake reader above (storage.azure.com); a token for one is
# rejected by the other.
#
# Fabric grants are not Azure RBAC: the identity needs a role on the WORKSPACE.
# Subscription Owner still gets a permission error on a table. See
# scripts/grant-fabric-mi-access.ps1.
#
# A PAUSED F2 capacity answers with ArtifactNotFound / a login failure that
# looks exactly like a dropped database. Check state before concluding anything:
#   az resource show -g rg-valc-demo-eastus -n fabvalcdemowestus3 \
#     --resource-type Microsoft.Fabric/capacities --query properties.state
#
# `memory` is the LOCAL default only. Every deployed environment sets `fabric`
# from infra/main.bicep: the memory adapter drops the manifest on the restart
# Container Apps performs whenever it scales from zero, and a run manifest is
# the record of which run produced a figure on a filed return.
#
# The warehouse pair below is not optional once the portal is served: Position
# by location READS every figure from tcc_gold, so an unset server is a 500 on
# the landing page rather than a slow one. Setting these also requires "ODBC
# Driver 18 for SQL Server" as a SYSTEM package — the pyodbc wheel alone is not
# enough (see backend/Dockerfile).
RUN_MANIFEST_STORE=memory
#   WAREHOUSE_SERVER=<id>.datawarehouse.fabric.microsoft.com
#   WAREHOUSE_DATABASE=<warehouse-database-name>
#   WAREHOUSE_ODBC_DRIVER=ODBC Driver 18 for SQL Server   # override for msodbcsql17
#   WAREHOUSE_CONNECT_TIMEOUT=90                          # seconds

# Commit the running code was built from, recorded in the calculation trail so a
# figure can be tied back to what produced it. Bicep passes it in deployed
# environments; unset locally means "unknown", which is honest.
#   GIT_COMMIT=

