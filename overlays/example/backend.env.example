# Example customer overlay — backend environment variables (WL-8).
#
# PLACEHOLDERS ONLY. See backend/.env.example for what every variable means.
#
# A DEPLOYED app never reads this file: Terraform computes every one of these
# settings as an App Service setting directly from infra.tfvars
# (infra/main.tf's `api_app_settings`), so the deployment path has no .env at
# all. This file exists for everything ELSE that needs the same values: local
# development against the customer's real lakehouse/warehouse, and the
# one-off scripts that are not run through Terraform
# (scripts/apply-migrations.py, scripts/grant-warehouse-sql.py,
# scripts/run-sql.py). Copy this directory to overlays/<name>/ (dropping the
# .example suffix), fill in every <...> value, and `copy` the result to
# `backend/.env` before running the API or any of those scripts locally.

# --- Data source ---------------------------------------------------------
DATA_SOURCE=lakehouse
FABRIC_WORKSPACE=<workspace-name-or-guid>
FABRIC_LAKEHOUSE=<lakehouse-name>
# The schema holding this customer's own source payroll (D14). Matches
# source_schema in infra.tfvars.
SOURCE_SCHEMA=<customer source schema>
TCC_WARM_ON_START=1

# --- Deployment posture [D26, DATA-5] -------------------------------------
# Terraform sets both of these as App Service settings (infra/main.tf,
# infra/locals.tf) for any deployed environment; they are listed here only so
# the overlay documents the whole picture, not because this file is read
# directly by the deployed process.
ENVIRONMENT=azure
DATA_CLASSIFICATION=customer
AUTH_MODE=entra
AUTH_TENANT_ID=<entra tenant id>
API_AUDIENCE=api://<api app registration client id>

# --- Artifacts [BLOB-3, BLOB-6] --------------------------------------------
ARTIFACT_STORE=blob
ARTIFACT_REPOSITORY=warehouse
ARTIFACT_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
OUTPUTS_RETENTION_DAYS=2555

# --- Operational + analytical stores [ADR-007] -----------------------------
# Every store is warehouse in every deployed environment: each holds
# decisions that land on a filed return.
CLAIM_STORE=warehouse
FINDING_STORE=warehouse
RUN_MANIFEST_STORE=warehouse
WAREHOUSE_SERVER=<id>.datawarehouse.fabric.microsoft.com
WAREHOUSE_DATABASE=<warehouse-database-name>

# --- Telemetry (optional) ---------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
