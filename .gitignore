# --- Customer overlays [WL-8] ---
# overlays/<name>/ holds a real customer's tfvars, .env and brand files —
# never tracked. Only the documentation and the placeholder example are.
# See overlays/README.md.
overlays/*
!overlays/README.md
!overlays/example/

# Prototype runtime caches
backend/data/evidence_cache.json

# Private reconciliation inputs
backend/data/payroll/
backend/data/reference_output/


# Operational store (ADR-002). The SQLite dev/CI adapter's database holds real
# client decisions -- claims, declines, filings. It is generated at runtime and
# must never be committed.
backend/data/operational.db
backend/data/operational.db-wal
backend/data/operational.db-shm