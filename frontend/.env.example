# Frontend env (Vite). Copy to .env.local for any non-default values.
# Only variables prefixed with VITE_ are exposed to client code.

# Override the API base URL when not using the Vite proxy (e.g. when the
# frontend is deployed to a static host and the backend lives on a separate
# origin). Leave unset to use the dev proxy in vite.config.js.
# VITE_API_BASE=https://tax-credit-copilot-api.azurewebsites.net

# --- Brand [WL-1, WL-8] ------------------------------------------------------
# The one place a deployment's name and logo come from (frontend/src/brand.config.js).
# Unset means the neutral "Tax Credit Copilot" brand this repo ships with. A
# customer overlay sets these at build time instead of editing any component —
# see overlays/README.md and overlays/example/frontend.env.example.
# VITE_BRAND_NAME=Tax Credit Copilot
# VITE_BRAND_SHORT_NAME=TCC
# VITE_BRAND_LOGO=/brand-mark.svg
# VITE_BRAND_FAVICON=/brand-mark.svg

# --- Theme [UI-01] -----------------------------------------------------------
# `modern` (default) or `classic`, the previous look kept so the revamp can be
# rolled back by configuration. A customer palette is not a third theme: it
# overrides semantic tokens in frontend/src/styles/overlay.css
# (docs/design/DESIGN-SYSTEM.md).
# VITE_THEME=modern
