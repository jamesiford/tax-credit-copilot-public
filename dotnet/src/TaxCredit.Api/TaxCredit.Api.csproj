<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TaxCredit.Api</RootNamespace>
    <!-- Microsoft.Data.SqlClient does not support invariant globalization; the shared default is on for deterministic tests. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- The conductor marks its hermetic launch with the inventory directory, not the hook flag. -->
  <Target Name="ConfigureContractReplayLaunch" BeforeTargets="ComputeRunArguments"
          Condition="('$(CONTRACT_DIR)' != '' or '$(TCC_CONTRACT_DIR)' != '') and '$(CONTRACT_HOOKS)' == '' and '$(TCC_CONTRACT_HOOKS)' == '' and (Exists('$(CONTRACT_DIR)\inventory\routes.json') or Exists('$(TCC_CONTRACT_DIR)\inventory\routes.json'))">
    <PropertyGroup>
      <RunArguments>$(RunArguments) --CONTRACT_HOOKS=1</RunArguments>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Contract\*.generated.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaxCredit.Application\TaxCredit.Application.csproj" />
    <ProjectReference Include="..\TaxCredit.Infrastructure\TaxCredit.Infrastructure.csproj" />
    <ProjectReference Include="..\TaxCredit.ServiceDefaults\TaxCredit.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaxCredit.Infrastructure.Persistence\TaxCredit.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\TaxCredit.Infrastructure.Sources\TaxCredit.Infrastructure.Sources.csproj" />
    <ProjectReference Include="..\TaxCredit.Infrastructure.Auth\TaxCredit.Infrastructure.Auth.csproj" />
    <ProjectReference Include="..\TaxCredit.Infrastructure.Ai\TaxCredit.Infrastructure.Ai.csproj" />
  </ItemGroup>
</Project>