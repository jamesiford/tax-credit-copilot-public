<Project>
  <!-- Build rules shared by every project. Warnings are errors: the Python side enforces its
       standards as a ratchet, here the compiler enforces them from line one. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Pin the conductor's explicitly supplied CPython 3.12 oracle for unattended parity tests.
       Explicit test settings can override this; OracleInterpreter still refuses a different minor version. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TaxCredit.Parity.Tests' and '$(VSTestSetting)' == ''">
    <VSTestSetting>$(MSBuildThisFileDirectory)tests\TaxCredit.Parity.Tests\oracle.runsettings</VSTestSetting>
  </PropertyGroup>

  <!-- One-release fallback for the renamed test switches (a developer's shell may still carry the old names). -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Compile Include="$(MSBuildThisFileDirectory)tests\Shared\LegacyTestEnvironment.cs" Link="Shared\LegacyTestEnvironment.cs" />
  </ItemGroup>
  <!-- Production projects: XML docs on every public member (CS1591 is an error via TreatWarningsAsErrors). -->
  <PropertyGroup Condition="'$(MSBuildProjectDirectory.Contains(&quot;\src\&quot;))' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
