    "path": "/api/chat",
    "json": {
     "message": "Who should we call first?"
    }
   }
  },
  {
   "id": "chat.ask-client",
   "request": {
    "method": "POST",
    "path": "/api/chat",
    "json": {
     "message": "Give me a brief",
     "client_id": 1001,
     "tax_year": 2025,
     "state": "GA"
    }
   }
  },
  {
