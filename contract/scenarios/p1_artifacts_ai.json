{
 "name": "p1_artifacts_ai",
 "profile": "P1",
 "variables": {
  "exception_id": "t2:E00200:2025-02",
  "draft_id": "00000000-0000-0000-0000-00000000dead",
  "batch_id": "00000000-0000-0000-0000-00000000beef",
  "artifact_id": "00000000-0000-0000-0000-00000000cafe"
 },
 "steps": [
  {
   "id": "boot.unit",
   "note": "capture an employee token and id from the unit drill",
   "request": {
    "method": "GET",
    "path": "/api/v2/clients/1001/units/GA_ATL_HQ",
    "query": [
     [
      "year",
      2025
     ],
     [
      "limit",
      2
     ]
    ]
   },
   "capture": {
    "token": "body.employees.0.record_token",
    "employee_id": "body.employees.0.employee_id"
   }
  },
  {
   "id": "boot.findings",
   "note": "capture a finding id",
   "request": {
    "method": "GET",
    "path": "/api/findings/1001/2025"
   },
   "capture": {
    "finding_id": "body.findings.0.finding_id"
   }
  },
  {
   "id": "package.create",
   "request": {
    "method": "POST",
    "path": "/api/clients/1001/packages",
    "query": [
     [
      "tax_year",
      2025
     ]
    ]
   },
   "capture": {
    "artifact_id": "body.artifact_id"
   }
  },
  {
   "id": "package.create-again",
   "request": {
    "method": "POST",
    "path": "/api/clients/1001/packages",
    "query": [
     [
      "tax_year",
      2025
     ]
    ]
   }
  },
  {
   "id": "package.no-year",
   "request": {
    "method": "POST",
    "path": "/api/clients/1001/packages"
   }
  },
  {
   "id": "package.year-abc",
   "request": {
    "method": "POST",
    "path": "/api/clients/1001/packages",
    "query": [
     [
      "tax_year",
      "abc"
     ]
    ]
   }
  },
  {
   "id": "package.unknown-client",
   "request": {
    "method": "POST",
    "path": "/api/clients/999999/packages",
    "query": [
     [
      "tax_year",
      2025
     ]
    ]
   }
  },
  {
   "id": "package.year-uncalculated",
   "request": {
    "method": "POST",
    "path": "/api/clients/1001/packages",
    "query": [
     [
      "tax_year",
      2019
     ]
    ]
   }
  },
  {
   "id": "artifact.download",
   "request": {
    "method": "GET",
    "path": "/api/clients/1001/artifacts/{{artifact_id}}"
   }
  },
  {
   "id": "artifact.download-head",
   "request": {
    "method": "HEAD",
    "path": "/api/clients/1001/artifacts/{{artifact_id}}"
   }
  },
  {
   "id": "artifact.wrong-client",
   "request": {
    "method": "GET",
    "path": "/api/clients/999999/artifacts/{{artifact_id}}"
   }
  },
  {
   "id": "artifact.unknown",
   "request": {
    "method": "GET",
    "path": "/api/clients/1001/artifacts/00000000-0000-0000-0000-000000000000"
   }
  },
  {
   "id": "artifact.bad-id",
   "request": {
    "method": "GET",
    "path": "/api/clients/1001/artifacts/not-a-uuid"
   }
  },
  {
